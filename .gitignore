# Ignore all Word documents
*.docx
*.doc
# Scraped originals from aquilo.in (337 MB) — regenerate with: node scripts/scrape.mjs
scraped/media/
scraped/download.log

# Local MCP connector config (may contain API keys)
.mcp.json

# Photography extracted from the catalogue PDFs (regenerate: see web/scripts/export-catalogue.mjs)
scraped/catalogue/

# Third-party 360 panoramas for local feature testing only — never publish
test-assets/

# Python bytecode (Blender-run CAD scripts)
__pycache__/
